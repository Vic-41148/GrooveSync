CREATE TABLE track (
    canonical_id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    title_sort TEXT NOT NULL,
    artist TEXT NOT NULL,
    artist_sort TEXT NOT NULL,
    album TEXT NOT NULL,
    duration_ms INTEGER NOT NULL,
    seen_run INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX track_title_sort ON track(title_sort);
CREATE INDEX track_artist_sort ON track(artist_sort);

upsert:
-- INSERT OR REPLACE, not UPSERT: minSdk 26 ships SQLite before 3.24, and every
-- column is supplied, so the delete-and-insert has nothing to lose.
INSERT OR REPLACE INTO track(canonical_id, title, title_sort, artist, artist_sort, album, duration_ms, seen_run)
VALUES (:canonical_id, :title, :title_sort, :artist, :artist_sort, :album, :duration_ms, :seen_run);

page:
SELECT canonical_id, title, artist, album, duration_ms
FROM track
ORDER BY title_sort
LIMIT :limit OFFSET :offset;

search:
SELECT canonical_id, title, artist, album, duration_ms
FROM track
WHERE title_sort LIKE :query OR artist_sort LIKE :query
ORDER BY title_sort
LIMIT :limit;

countAll:
SELECT count(*) FROM track;

deleteUnseen:
DELETE FROM track WHERE seen_run <> :run_id;
